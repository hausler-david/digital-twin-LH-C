# LHμC-VirtualLab environment template. Copy to .env (git-ignored). Never commit secrets.
LHMUC_ENV=development
LHMUC_RESULTS_DIR=./results
LHMUC_REFERENCES_LOCAL=./references/_local
# External tool roots (empty = not installed; the platform must degrade gracefully)
MADGRAPH_ROOT=
PYTHIA8_ROOT=
GEANT4_ROOT=
BDSIM_ROOT=
LHAPDF_DATA_PATH=
# Backend (future milestones)
LHMUC_DATABASE_URL=sqlite:///./results/lhmuc.sqlite
LHMUC_API_PORT=8000
