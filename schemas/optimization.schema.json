{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lhmuc-virtuallab.org/schemas/optimization.schema.json",
  "title": "Optimization study record",
  "description": "Every optimization result must expose objectives, bounds, constraints, optimizer, seed, stopping criterion, evaluations, fidelity, feasibility, convergence evidence, uncertainty and high-fidelity verification. A missing hard-constraint bound blocks conclusions (constraint status 'unresolved').",
  "type": "object", "additionalProperties": false,
  "properties": {
    "optimization_id": {"type": "string", "pattern": "^OPT_[A-Z0-9_]+$"},
    "experiment_ids": {"type": "array", "items": {"type": "string"}},
    "variables": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "properties": {"parameter_id": {"type": "string"}, "lower": {"type": "number"}, "upper": {"type": "number"}, "unit": {"type": "string"}, "bound_provenance": {"$ref": "provenance.schema.json#/$defs/provenance_status"}}, "required": ["parameter_id", "lower", "upper", "unit", "bound_provenance"]}},
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "properties": {"name": {"type": "string"}, "definition": {"type": "string"}, "direction": {"type": "string", "enum": ["minimize", "maximize"]}, "fidelity_tier": {"$ref": "provenance.schema.json#/$defs/fidelity_tier"}}, "required": ["name", "definition", "direction", "fidelity_tier"]}},
    "hard_constraints": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {"name": {"type": "string"}, "expression": {"type": "string", "description": "g_k(theta) <= 0"}, "bound_parameter_id": {"type": ["string", "null"]}, "status": {"type": "string", "enum": ["bounded", "unresolved"]}}, "required": ["name", "expression", "status"]}},
    "soft_constraints": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "optimizer": {"type": "object", "additionalProperties": false, "properties": {"method": {"type": "string"}, "library": {"type": "string"}, "version": {"type": "string"}, "settings": {"type": "object", "additionalProperties": true}}, "required": ["method", "library", "version"]},
    "random_seed": {"type": "integer"},
    "stopping_criterion": {"type": "string"},
    "number_of_evaluations": {"type": "integer"},
    "simulation_fidelity": {"$ref": "provenance.schema.json#/$defs/fidelity_tier"},
    "feasibility_rate": {"type": ["number", "null"]},
    "convergence_evidence": {"type": "string"},
    "uncertainty_treatment": {"type": "string"},
    "high_fidelity_verification_status": {"type": "string", "enum": ["not_started", "planned", "in_progress", "verified", "failed"]},
    "pareto_set_run_ids": {"type": "array", "items": {"type": "string"}},
    "weights_visible_and_editable": {"type": "boolean", "const": true},
    "conclusions_blocked_by": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "code_commit": {"type": "string"}
  },
  "required": ["optimization_id", "variables", "objectives", "hard_constraints", "optimizer", "random_seed", "stopping_criterion", "number_of_evaluations", "simulation_fidelity", "feasibility_rate", "convergence_evidence", "uncertainty_treatment", "high_fidelity_verification_status", "weights_visible_and_editable", "conclusions_blocked_by", "created_at", "code_commit"]
}
