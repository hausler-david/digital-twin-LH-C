{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lhmuc-virtuallab.org/schemas/simulation_run.schema.json",
  "title": "Immutable simulation run record",
  "type": "object", "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string", "pattern": "^lhmuc-[a-z0-9]+-[0-9]{6}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "code_commit": {"type": "string"},
    "fidelity_tier": {"$ref": "provenance.schema.json#/$defs/fidelity_tier"},
    "validation_level": {"$ref": "provenance.schema.json#/$defs/validation_level"},
    "is_interface_demo_only": {"type": "boolean", "description": "true for synthetic demonstration samples; such runs are excluded from scientific reports."},
    "machine_scenario_id": {"type": "string"},
    "machine_version": {"type": "string"},
    "geometry_version": {"type": ["string", "null"]},
    "theory_version": {"type": ["string", "null"]},
    "detector_version": {"type": ["string", "null"]},
    "proposal_id": {"type": ["string", "null"]},
    "process": {"type": ["string", "null"]},
    "pdf_set": {"type": ["string", "null"]},
    "scales": {"type": ["object", "null"], "additionalProperties": true},
    "cuts": {"type": "array", "items": {"type": "string"}},
    "random_seed": {"type": ["integer", "null"]},
    "requested_events": {"type": ["integer", "null"]},
    "generated_events": {"type": ["integer", "null"]},
    "accepted_events": {"type": ["integer", "null"]},
    "cross_section": {"anyOf": [{"$ref": "provenance.schema.json#/$defs/quantity"}, {"type": "null"}]},
    "cross_section_uncertainty": {"$ref": "provenance.schema.json#/$defs/uncertainty"},
    "negative_weight_handling": {"type": ["string", "null"]},
    "software_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "environment": {"type": ["object", "null"], "additionalProperties": true},
    "inputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}}, "required": ["path", "sha256"]}},
    "outputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}, "kind": {"type": "string"}}, "required": ["path", "sha256"]}},
    "assumption_ids": {"type": "array", "items": {"type": "string"}},
    "dependency_parameter_ids": {"type": "array", "items": {"type": "string"}},
    "stale": {"type": "boolean", "description": "set true when any dependency changed after the run; stale results are never reused silently."},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "failures": {"type": "array", "items": {"type": "string"}},
    "validation_results": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["queued", "running", "completed", "failed", "invalidated"]}
  },
  "required": ["run_id", "created_at", "code_commit", "fidelity_tier", "validation_level", "is_interface_demo_only", "machine_scenario_id", "machine_version", "random_seed", "software_versions", "inputs", "outputs", "assumption_ids", "dependency_parameter_ids", "stale", "status"]
}
