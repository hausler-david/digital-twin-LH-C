{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lhmuc-virtuallab.org/schemas/archived_metadata.schema.json",
  "title": "Archived-file metadata (research/archived_metadata/<source_id>.json)",
  "description": "One record per archived document (docs/internet_research_protocol.md §6). content_kind pdf (or absent): a file supplied by the owner or downloaded; sha256 is that of the file. content_kind connector_text: the text delivered by the owner-authorised alphaXiv connector, saved byte for byte (no PDF file, no page images; docs/internet_research_protocol.md §5a); sha256 is that of the saved text, and the page-tagged responses used for page attribution are listed with their own hashes.",
  "type": "object", "additionalProperties": false,
  "properties": {
    "source_id": {"type": "string", "pattern": "^SRC_[A-Z0-9_]+$"},
    "local_file": {"type": "string"},
    "committed_copy": {"type": ["string", "null"]},
    "title": {"type": "string"},
    "authors": {"type": "string"},
    "venue": {"type": "string"},
    "identifier": {"type": ["string", "null"]},
    "category": {"type": "string"},
    "licence": {"type": "string"},
    "redistribution": {"type": "string"},
    "pages": {"type": ["integer", "null"]},
    "size_bytes": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "upload_name": {"type": ["string", "null"]},
    "archived_on": {"type": "string"},
    "archive_method": {"type": "string"},
    "read_status": {"type": "string"},
    "content_kind": {"type": "string", "enum": ["pdf", "connector_text"]},
    "connector": {"type": "string"},
    "connector_tool": {"type": "string"},
    "connector_calls": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "properties": {"tool": {"type": "string"}, "arguments": {"type": "object"}, "tool_use_id": {"type": "string"},
                     "called_on": {"type": "string"}},
      "required": ["tool", "arguments", "tool_use_id", "called_on"]}},
    "delivered_version": {"type": "string", "pattern": "^v[0-9]+$"},
    "version_evidence": {"type": "string"},
    "page_images": {"type": "boolean"},
    "page_tag_files": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "properties": {"file": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                     "size_bytes": {"type": "integer", "minimum": 0}, "pages": {"type": "array", "items": {"type": "integer"}},
                     "tool_use_id": {"type": "string"}},
      "required": ["file", "sha256", "pages", "tool_use_id"]}},
    "instruction_scan": {"type": "object", "additionalProperties": false,
                         "properties": {"patterns_version": {"type": "string"},
                                        "hits": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                                 "properties": {"line": {"type": "integer"}, "text": {"type": "string"},
                                                                "kind": {"type": "string", "enum": ["line", "collapsed"]}},
                                                 "required": ["line", "text"]}}},
                         "required": ["patterns_version", "hits"]},
    "storage": {"type": "string"}
  },
  "required": ["source_id", "local_file", "committed_copy", "title", "authors", "venue", "identifier", "category", "licence",
               "redistribution", "pages", "size_bytes", "sha256", "upload_name", "archived_on", "archive_method", "read_status"],
  "allOf": [
    {"if": {"properties": {"content_kind": {"const": "connector_text"}}, "required": ["content_kind"]},
     "then": {"required": ["connector", "connector_tool", "connector_calls", "delivered_version", "version_evidence", "page_images",
                           "page_tag_files", "instruction_scan", "storage"],
              "properties": {"local_file": {"pattern": "^references/_local/SRC_ARXIV_[A-Z0-9_]+/\\S+\\.txt$"},
                             "committed_copy": {"const": null}, "upload_name": {"const": null},
                             "page_images": {"const": false}}}}
  ]
}
